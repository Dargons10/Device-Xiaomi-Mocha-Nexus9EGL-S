From 4503c39de30518f5cfab7d3dbbea8a33782742ae Mon Sep 17 00:00:00 2001
From: Dargons10 <jdamr2p@gmail.com>
Date: Wed, 30 Sep 2026 22:16:15 +0200
Subject: [PATCH] fix: LDAC codec unavailable

The LDAC decoder/encoder library (libldacBT_bco.so) is not available
on this device. Do not create the LDAC codec to avoid the dlopen error.

Co-authored-by: Qwen3.8-27B-local
Change-Id: I14bb80211e3aaf8250c3d818e72e0628d0c065bf
Signed-off-by: Opencode <opencode@opencode.ai>
---
 stack/a2dp/a2dp_codec_config.cc | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/stack/a2dp/a2dp_codec_config.cc b/stack/a2dp/a2dp_codec_config.cc
index 0bfefb068..7e18ed857 100644
--- a/stack/a2dp/a2dp_codec_config.cc
+++ b/stack/a2dp/a2dp_codec_config.cc
@@ -136,10 +136,9 @@ A2dpCodecConfig* A2dpCodecConfig::createCodec(
     case BTAV_A2DP_CODEC_INDEX_SOURCE_APTX_ADAPTIVE:
       break;
     case BTAV_A2DP_CODEC_INDEX_SOURCE_LDAC:
-      codec_config = new A2dpCodecConfigLdacSource(codec_priority);
-      break;
     case BTAV_A2DP_CODEC_INDEX_SINK_LDAC:
-      codec_config = new A2dpCodecConfigLdacSink(codec_priority);
+      // LDAC decoder/encoder library (libldacBT_bco.so) is not available on
+      // this device; do not create the LDAC codec to avoid the dlopen error.
       break;
 #endif
     case BTAV_A2DP_CODEC_INDEX_SOURCE_APTX_TWS:
-- 
2.47.3

