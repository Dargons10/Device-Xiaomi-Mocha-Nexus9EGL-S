<?xml version="1.0" encoding="utf-8" ?>
<!-- Test build 2026-11-17: the OMX.Nvidia.* components are taken out of the advertised list.

     Measured on this tree:
       - Android 12 no longer builds libOmxCore / libOmxVenc / libOmxVdec (grep over
         frameworks/av/media/libstagefright/Android.bp returns nothing), so the legacy OMX path
         that debug.stagefright.ccodec=0 forces has no component host at all.
       - The 2015 blobs only carry libnvomx.so, libnvomxadaptor.so and libnvomxilclient.so, which
         are OMX components that used to be loaded by that core; nothing loads them now.
       - With that setting the recorder fails before touching the camera:
         StagefrightRecorder::setupCameraSource -> checkVideoEncoderCapabilities -> -19 (-ENODEV),
         MediaRecorder.start failed: -19, and Camera2 reports "start failed.".
-->
<MediaCodecs>
    <Settings>
        <Setting name="max-video-encoder-input-buffers" value="6" />
    </Settings>
    <Include href="media_codecs_google_audio.xml" />
    <Include href="media_codecs_google_video.xml" />
</MediaCodecs>
