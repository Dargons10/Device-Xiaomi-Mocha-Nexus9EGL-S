# The Tegra camera HAL wrapper (camera.tegra) plus the NVIDIA vendor blob
# (camera.vendor.tegra.so) run inside the vendor camera provider.
#
# The legacy sensor shim (libmocha_sensor_shim) talks to the system
# sensors service to provide the accelerometer/gyro used for EIS.
#
# OJO (port 17.1 -> 19.1): en A12 el tipo `sensors_service` YA NO EXISTE
# (grep -rn '^type sensors_service' system/sepolicy/ = vacío). El servicio se llama
# `sensorservice` (live: service list -> "160 sensorservice: [android.gui.SensorServer]",
# vive en system_server) y su tipo público es `sensorservice_service`
# (system/sepolicy/public/service.te:191). Usar el nombre del 17.1 rompe checkpolicy:
#   sepolicy/mocha/hal_camera_default.te:21:ERROR 'unknown type sensors_service'
allow hal_camera_default sensorservice_service:service_manager find;
allow hal_camera_default system_server:binder call;

# Legacy binder mode (ro.camera.legacy_system_binder=true): the provider
# process opens /dev/binder instead of /dev/vndbinder, registers its HIDL
# services on the framework servicemanager and (through libgui/libbinder
# inside the NVIDIA blob) talks to SurfaceFlinger.
binder_use(hal_camera_default)
allow hal_camera_default servicemanager:service_manager find;
allow hal_camera_default surfaceflinger:service_manager find;
binder_call(hal_camera_default, surfaceflinger)

# The blob reads /etc/nvcamera.conf and /etc/model_frontal.xml
# (= /system/etc) at init.
r_dir_file(hal_camera_default, system_file)
