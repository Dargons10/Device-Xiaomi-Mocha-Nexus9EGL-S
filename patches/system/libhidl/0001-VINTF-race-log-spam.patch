From 578778547475b6f0737c4f015c97bbc33a712c66 Mon Sep 17 00:00:00 2001
From: Dargons10 <jdamr2p@gmail.com>
Date: Wed, 30 Sep 2026 22:16:23 +0200
Subject: [PATCH] fix: VINTF race log spam

Remove the ALOGE warning about VINTF manifest not being enforced.
The device is a legacy (pre-Treble) Tegra124 board with
PRODUCT_ENFORCE_VINTF_MANIFEST_OVERRIDE=false, so the race is
expected and the log is pure noise (155 occurrences per boot).
The sleep(1) is kept to give HAL servers time to register.

Co-authored-by: Qwen3.8-27B-local
Change-Id: I812096f82ae7435059234a2ea7aafcde2ba3ce8c
Signed-off-by: Opencode <opencode@opencode.ai>
---
 transport/ServiceManagement.cpp | 6 ------
 1 file changed, 6 deletions(-)

diff --git a/transport/ServiceManagement.cpp b/transport/ServiceManagement.cpp
index c638279..a5f25a1 100644
--- a/transport/ServiceManagement.cpp
+++ b/transport/ServiceManagement.cpp
@@ -769,12 +769,6 @@ sp<::android::hidl::base::V1_0::IBase> getRawServiceInternal(const std::string&
     const bool vintfLegacy = (transport == Transport::EMPTY) && allowLegacy;
 
     if (!kEnforceVintfManifest) {
-        ALOGE("getService: Potential race detected. The VINTF manifest is not being enforced. If "
-              "a HAL server has a delay in starting and it is not in the manifest, it will not be "
-              "retrieved. Please make sure all HALs on this device are in the VINTF manifest and "
-              "enable PRODUCT_ENFORCE_VINTF_MANIFEST on this device (this is also enabled by "
-              "PRODUCT_FULL_TREBLE). PRODUCT_ENFORCE_VINTF_MANIFEST will ensure that no race "
-              "condition is possible here.");
         sleep(1);
     }
 
