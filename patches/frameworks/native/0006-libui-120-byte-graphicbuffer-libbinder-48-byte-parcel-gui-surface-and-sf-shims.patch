+        if (freopen(path, "ae", stderr) != nullptr) {
+            setvbuf(stderr, nullptr, _IONBF, 0);
+            fprintf(stderr, "mocha-sfdbg: stderr -> %s (pid %d)\n", path, getpid());
+            fflush(stderr);
