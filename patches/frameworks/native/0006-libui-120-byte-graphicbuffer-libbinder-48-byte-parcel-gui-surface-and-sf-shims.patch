 namespace android {
 
+// mocha: newer Parcel bookkeeping lives here so that the object itself keeps the
+// 48-byte layout that the stock 32-bit NVIDIA/Tegra clients assume.
+struct Parcel::ParcelState {
+    size_t mOpenAshmemSize = 0;
+    mutable sp<RpcSession> mSession;
+    size_t mWorkSourceRequestHeaderPosition = 0;
+    bool mRequestHeaderPresent = false;
+    mutable bool mDeallocZero = false;
+};
+
 // many things compile this into prebuilts on the stack
 #ifdef __LP64__
-static_assert(sizeof(Parcel) == 120);
+// 64-bit/host builds never ship the stock-blob compatibility layout; only a
+// sanity floor is enforced there (host tools such as linux_glibc libbinder do
+// not have a fixed ABI requirement).
+static_assert(sizeof(Parcel) >= 48);
 #else
-static_assert(sizeof(Parcel) == 60);
+// Stock mocha blobs (libnvcpl.so, libnvremoteprotocol.so, libnvaudioservice.so, ...)
+// construct android::Parcel inside stack frames sized for exactly 48 bytes; a 60-byte
+// Parcel overflows them by 12 bytes and overwrites their saved r4/r5/r6 slots.
+static_assert(sizeof(Parcel) == 48, "stock NVIDIA/Tegra clients allocate 48-byte Parcels");
 #endif
 
 static std::atomic<size_t> gParcelGlobalAllocCount;
@@ -202,7 +219,7 @@ status_t Parcel::flattenBinder(const sp<IBinder>& binder)
             status_t status = writeInt32(1); // non-null
             if (status != OK) return status;
             RpcAddress address = RpcAddress::zero();
-            status = mSession->state()->onBinderLeaving(mSession, binder, &address);
+            status = mState->mSession->state()->onBinderLeaving(mState->mSession, binder, &address);
             if (status != OK) return status;
             status = address.writeToParcel(this);
             if (status != OK) return status;
@@ -273,7 +290,7 @@ status_t Parcel::flattenBinder(const sp<IBinder>& binder)
 status_t Parcel::unflattenBinder(sp<IBinder>* out) const
 {
     if (isForRpc()) {
-        LOG_ALWAYS_FATAL_IF(mSession == nullptr, "RpcSession required to read from remote parcel");
+        LOG_ALWAYS_FATAL_IF(mState->mSession == nullptr, "RpcSession required to read from remote parcel");
 
         int32_t isNull;
         status_t status = readInt32(&isNull);
@@ -285,7 +302,7 @@ status_t Parcel::unflattenBinder(sp<IBinder>* out) const
             auto addr = RpcAddress::zero();
             status_t status = addr.readFromParcel(*this);
             if (status != OK) return status;
-            binder = mSession->state()->onBinderEntering(mSession, addr);
+            binder = mState->mSession->state()->onBinderEntering(mState->mSession, addr);
         }
 
         return finishUnflattenBinder(binder, out);
@@ -312,7 +329,7 @@ status_t Parcel::unflattenBinder(sp<IBinder>* out) const
 
 // ---------------------------------------------------------------------------
 
-Parcel::Parcel()
+Parcel::Parcel() : mState(new ParcelState)
 {
     LOG_ALLOC("Parcel %p: constructing", this);
     initState();
@@ -321,6 +338,8 @@ Parcel::Parcel()
 Parcel::~Parcel()
 {
     freeDataNoInit();
+    delete mState;
+    mState = nullptr;
     LOG_ALLOC("Parcel %p: destroyed", this);
