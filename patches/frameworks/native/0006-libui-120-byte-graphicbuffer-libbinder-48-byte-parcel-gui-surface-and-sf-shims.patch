-    if (!mRequestHeaderPresent) {
-        mWorkSourceRequestHeaderPosition = dataPosition();
-        mRequestHeaderPresent = true;
+    if (!mState->mRequestHeaderPresent) {
+        mState->mWorkSourceRequestHeaderPosition = dataPosition();
