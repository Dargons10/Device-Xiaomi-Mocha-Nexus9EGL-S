-    // data to be overridden with zero when deallocated
-    mutable bool        mDeallocZero;
-
     release_func        mOwner;
 
-    sp<RpcSession> mSession;
+    // mocha: stock 32-bit NVIDIA/Tegra clients (libnvcpl, libnvremoteprotocol,
+    // libnvaudioservice, libnvcapaudioservice, ...) reserve exactly 48 bytes when
+    // they allocate an android::Parcel on the stack. A larger Parcel makes their
+    // Parcel constructor write past the end of their own stack frame and destroy
+    // the saved callee-saved registers (r4/r5/r6) of *their* callers, which here
+    // are libEGL_tegra_impl.so and hwcomposer.tegra.so - that is the source of
+    // the SIGSEGV null dereferences at libEGL_tegra_impl+0x11d06 / +0x11dc2.
+    // Newer bookkeeping therefore lives in heap state so that sizeof(Parcel)
+    // stays 48 bytes on ARM32. See patches/frameworks/native/0004-*.patch.
+    struct ParcelState;
+    ParcelState*        mState;
 
     class Blob {
     public:
