     }
 
@@ -475,6 +481,7 @@ wifi_error wifi_pre_initialize(void)
         nl_socket_free(event_sock);
         pthread_mutex_destroy(&halInfo->cb_lock);
         free(halInfo);
+        halInfo = NULL;
         return WIFI_ERROR_NOT_AVAILABLE;
     }
 
@@ -599,6 +606,7 @@ static void internal_cleaned_up_handler(wifi_handle handle)
     DestroyResponseLock();
     pthread_mutex_destroy(&info->cb_lock);
     free(info);
+    halInfo = NULL;
 
     ALOGI("Internal cleanup completed");
 }
@@ -617,6 +625,14 @@ void wifi_cleanup(wifi_handle handle, wifi_cleaned_up_handler handler)
     }
 
     hal_info *info = getHalInfo(handle);
+    if (!info || info != halInfo) {
+        // Null handle, or a stale handle from a previous (already freed)
+        // initialization. Operating on it would be a use-after-free and
+        // crash the service. Bail out and still signal completion.
+        ALOGE("wifi_cleanup: null/stale hal_info, ignoring");
+        if (handler) handler(handle);
+        return;
+    }
     char buf[64];
     wifi_error result;
 
@@ -668,6 +684,15 @@ void wifi_cleanup(wifi_handle handle, wifi_cleaned_up_handler handler)
         cmd_info *cmdi = &(info->cmd[bad_commands]);
         WifiCommand *cmd = cmdi->cmd;
         if (cmd != NULL) {
+            // A command may have been freed by a concurrent response on the
+            // event loop thread; its vtable pointer is then NULL. Calling
+            // cancel() on it would SIGSEGV (wifi_cleanup+550 crash).
+            if (*(void **)cmd == NULL) {
+                ALOGE("Skipping freed command %p at index %d", cmd, bad_commands);
+                info->cmd[bad_commands].cmd = NULL;
+                bad_commands++;
+                continue;
+            }
             ALOGI("Cancelling command %p:%s", cmd, cmd->getType());
             pthread_mutex_unlock(&info->cb_lock);
             cmd->cancel();
@@ -697,9 +722,13 @@ void wifi_cleanup(wifi_handle handle, wifi_cleaned_up_handler handler)
 
     info->clean_up = true;
 
-    if (TEMP_FAILURE_RETRY(write(info->cleanup_socks[0], "Exit", 4)) < 1) {
-        // As a fallback set the cleanup flag to TRUE
-        ALOGE("could not write to the cleanup socket");
+    if (info->cleanup_socks[0] >= 0) {
+        if (TEMP_FAILURE_RETRY(write(info->cleanup_socks[0], "Exit", 4)) < 1) {
+            // As a fallback set the cleanup flag to TRUE
+            ALOGE("could not write to the cleanup socket");
+        }
+    } else {
+        ALOGE("cleanup socket not valid, skipping event loop termination signal");
     }
     ALOGE("wifi_clean_up done");
 }
